{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Battleground Commander Prototype",
  "version": "0.0.1",
  "identifier": "dev.battleground.commander-sidecar-prototype",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Commander supervision prototype",
        "width": 980,
        "height": 760
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/battleground-commander"],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/igrgin/autoresearch-platform-app/releases/latest/download/latest.json"
      ],
      "pubkey": "PROTOTYPE_REPLACE_WITH_TAURI_PUBLIC_KEY"
    }
  }
}
